# Firebase — used only by the contact form to store incoming messages.
# Create a web app in the Firebase console, then copy its config values here
# into a local .env file (which is git-ignored).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Resend — used by the /api/contact serverless function to email a copy of
# each contact-form submission. These are server-only: no VITE_ prefix, so
# Vite never inlines them into the browser bundle. Set them in the Vercel
# project's Environment Variables, not just here.
RESEND_API_KEY=
# The sender. With no domain of your own, use Resend's shared sender exactly
# as written below; Resend then only allows delivery to the address you
# signed up with, which CONTACT_TO_EMAIL must match. Once you do verify a
# domain, change this to an address on it and the restriction lifts.
CONTACT_FROM_EMAIL=onboarding@resend.dev
# Where the notification lands.
CONTACT_TO_EMAIL=
